# TEMPLATE — Edge Function secrets for ONE Supabase project (staging first). Names only: no value here is real.
# Set them with the Supabase dashboard (Edge Functions → Secrets) or `supabase secrets set --env-file <file>`, using a
# copy kept OUTSIDE the repository. Never commit a filled-in copy (.gitignore blocks *.env except *.example.env).
# Comments are on their own lines on purpose: some env-file parsers would read a trailing comment as the value.
#
# Provided by the platform to every Edge Function (do not set by hand): the project URL, the anon key and the
# service-role key (see functions/_shared/deno.ts). The service-role key exists only inside the functions.
#
# Required: a missing value stops the function with "missing configuration: <NAME>" (fail closed).
#
# Internal sign-in address domain (decision D4). Company-controlled; receives NO mail.
CMMS_SIGN_IN_DOMAIN=
# https://<app host>/ — recovery and confirmation links return here. Also add it to Auth → URL Configuration → Redirect URLs.
CMMS_APP_URL=
# https://<app host> — the only allowed CORS origin (no trailing slash).
CMMS_APP_ORIGIN=
# At least 32 random bytes (e.g. base64): HMAC key for rate-limit subjects and verification tokens.
CMMS_HASH_PEPPER=
# Transactional mail endpoint of the chosen provider (decision D4), and its API token.
CMMS_MAIL_API_URL=
CMMS_MAIL_API_TOKEN=
#
# Optional. Anything other than exactly "enabled" (including missing) keeps Department User accounts OFF: they cannot be
# created active or activated. Set to "enabled" only after DEPLOYMENT.md step P9 has passed.
CMMS_DEPARTMENT_USERS=
